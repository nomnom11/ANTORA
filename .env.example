# CATATAN: versi saat ini adalah situs statis dan TIDAK membaca file .env.
# Semua nilai resmi diisi di js/config.js.
# File ini hanya daftar rujukan nilai yang sama, berguna jika nanti situs
# dipindahkan ke Next.js (gunakan awalan NEXT_PUBLIC_ untuk nilai publik).
# Jangan pernah menaruh rahasia (kunci pribadi, seed phrase, API key privat) di sini.

# Tautan resmi (kosongkan sampai diumumkan)
NEXT_PUBLIC_BUY_URL=
NEXT_PUBLIC_WHITEPAPER_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_X_URL=https://x.com/AntoraAI

# Informasi token (kosongkan sampai resmi)
NEXT_PUBLIC_BLOCKCHAIN=
NEXT_PUBLIC_TOTAL_SUPPLY=
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_TOKEN_UTILITY=
NEXT_PUBLIC_VESTING=
